# Force LF line endings for all text files on all platforms
* text=auto eol=lf

# Explicitly declare text files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.ico   binary
